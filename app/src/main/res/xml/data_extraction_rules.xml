<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="voice_secrets.xml" />
        <!-- SenseVoice 本地 ASR 模型目录（~228MB）：位于 getExternalFilesDir，
             对应 external 域；不入云备份（损坏凭下载器重下恢复） -->
        <exclude
            domain="external"
            path="sensevoice/" />
        <!-- 外存不可用时模型回退 filesDir/sensevoice/，同样排除 -->
        <exclude
            domain="file"
            path="sensevoice/" />
        <exclude
            domain="file"
            path="usr" />
        <exclude
            domain="file"
            path="descriptor.json" />
        <exclude
            domain="file"
            path="licenses.json" />
        <exclude
            domain="file"
            path="README.md" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="voice_secrets.xml" />
        <exclude
            domain="external"
            path="sensevoice/" />
        <exclude
            domain="file"
            path="sensevoice/" />
        <exclude
            domain="file"
            path="usr" />
        <exclude
            domain="file"
            path="descriptor.json" />
        <exclude
            domain="file"
            path="licenses.json" />
        <exclude
            domain="file"
            path="README.md" />
    </device-transfer>
</data-extraction-rules>